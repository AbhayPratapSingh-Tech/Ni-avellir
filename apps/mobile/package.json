{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "android": "bash ./scripts/wait-for-android-device.sh && react-native run-android",
    "android:install": "bash ./scripts/wait-for-android-device.sh && adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "android:release": "bash ./scripts/gradlew-android.sh",
    "gradlew-android": "bash ./scripts/gradlew-android.sh",
    "build": "tsc -p tsconfig.json --noEmit",
    "dev": "react-native start",
    "ios": "react-native run-ios",
    "lint": "eslint src --ext .ts,.tsx",
    "postinstall": "node ./scripts/ensure-mobile-node-modules.js",
    "prestart": "npm run build -w @nidavellir/shared && node ./scripts/ensure-mobile-node-modules.js",
    "preandroid": "npm run build -w @nidavellir/shared && node ./scripts/ensure-mobile-node-modules.js",
    "start": "react-native start",
    "test": "echo \"No mobile tests yet\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nidavellir/shared": "*",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-firebase/app": "^21.7.1",
    "@react-native-firebase/messaging": "^21.7.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@reduxjs/toolkit": "^2.5.0",
    "@shopify/flash-list": "^1.7.2",
    "@tanstack/react-query": "^5.64.2",
    "axios": "^1.7.9",
    "date-fns": "^4.1.0",
    "lottie-react-native": "7.2.2",
    "react": "18.3.1",
    "react-hook-form": "^7.54.2",
    "react-native": "0.77.3",
    "react-native-fast-image": "^8.6.3",
    "react-native-gesture-handler": "2.24.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-keychain": "^9.2.2",
    "react-native-razorpay": "^3.0.0",
    "react-native-reanimated": "3.17.5",
    "react-native-safe-area-context": "^5.1.0",
    "react-native-screens": "4.9.2",
    "react-native-svg": "15.11.2",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.1.3",
    "@react-native-community/cli-platform-android": "15.1.3",
    "@react-native-community/cli-platform-ios": "15.1.3",
    "@react-native/babel-preset": "0.77.3",
    "@react-native/metro-config": "0.77.3",
    "@react-native/typescript-config": "0.77.3",
    "@types/react": "^18.2.6"
  },
  "engines": {
    "node": ">=18"
  }
}
