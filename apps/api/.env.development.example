NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
MONGODB_URI=mongodb://localhost:27017/nidavellir_dev
JWT_ACCESS_SECRET=replace-with-development-access-secret
JWT_REFRESH_SECRET=replace-with-development-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
RESEND_API_KEY=replace-with-resend-development-key
# Dev: EMAIL_DEMO_MODE=true logs mail to API console. Prod: false + real RESEND_API_KEY + verified EMAIL_FROM.
EMAIL_FROM=Niðavellir <onboarding@resend.dev>
EMAIL_DEMO_MODE=true
# Leave as replace-with-* to use built-in Razorpay DEMO mode (signed dummy checkout).
# Or paste Razorpay Dashboard → Test Mode keys (rzp_test_...) for real test checkout.
RAZORPAY_KEY_ID=replace-with-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
# Razorpay Dashboard → Webhooks → secret (required for POST /payments/razorpay/webhook)
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret
CORS_ORIGINS=http://localhost:8081
# SMS OTP — set SMS_DEMO_MODE=true to log OTP in API console (no SMS credits).
# For real SMS: SMS_PROVIDER=msg91 or twilio + provider keys below.
SMS_PROVIDER=none
SMS_DEMO_MODE=true
MSG91_AUTH_KEY=replace-with-msg91-auth-key
MSG91_TEMPLATE_ID=replace-with-msg91-template-id
MSG91_SENDER_ID=NIDAVL
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_FROM_NUMBER=replace-with-twilio-from-number
