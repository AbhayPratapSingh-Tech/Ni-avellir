NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
MONGODB_URI=mongodb://localhost:27017/nidavellir_dev
JWT_ACCESS_SECRET=replace-with-development-access-secret
JWT_REFRESH_SECRET=replace-with-development-refresh-secret
RESEND_API_KEY=replace-with-resend-development-key
