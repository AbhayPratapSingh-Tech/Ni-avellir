NODE_ENV=staging
PORT=4000
API_BASE_URL=https://nidavellir-api-uat.onrender.com
MONGODB_URI=mongodb+srv://replace-with-user:replace-with-password@cluster-host/nidavellir_uat
JWT_ACCESS_SECRET=replace-with-staging-access-secret
JWT_REFRESH_SECRET=replace-with-staging-refresh-secret
RESEND_API_KEY=replace-with-resend-staging-key
RAZORPAY_KEY_ID=replace-with-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-a-different-webhook-secret
CORS_ORIGINS=https://staging.example.com
EMAIL_FROM=Niðavellir <onboarding@resend.dev>
EMAIL_DEMO_MODE=false
SMS_DEMO_MODE=true
AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile
OPENAI_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
PENDING_PAYMENT_EXPIRE_MINUTES=30
PAYMENT_RECONCILE_INTERVAL_MS=300000
# Copy Resend, Razorpay Test keys, and OPENAI_* from production.
# Keep this file's MONGODB_URI on database nidavellir_uat, and use different JWT and webhook secrets.
