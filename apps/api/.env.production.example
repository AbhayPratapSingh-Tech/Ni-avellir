NODE_ENV=production
PORT=4000
API_BASE_URL=https://api.example.com
MONGODB_URI=mongodb+srv://replace-with-production-uri
JWT_ACCESS_SECRET=replace-with-production-access-secret
JWT_REFRESH_SECRET=replace-with-production-refresh-secret
RESEND_API_KEY=replace-with-resend-production-key
EMAIL_FROM=Niðavellir <onboarding@resend.dev>
EMAIL_DEMO_MODE=false
RAZORPAY_KEY_ID=replace-with-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret
CORS_ORIGINS=https://example.com
# AI Merch Assistant — Groq example (optional; stub works without key)
AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile
